{
  "name": "DRSS Flutter Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "GitHub.copilot",
        "GitHub.vscode-github-actions"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter"
      }
    }
  },
  "forwardPorts": [
    3000,
    5000,
    8080
  ],
  "postCreateCommand": "flutter doctor && flutter config --enable-web && firebase --version",
  "remoteUser": "vscode"
}
